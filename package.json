{
  "name": "anakberani-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply anakberani-db --local",
    "db:remote": "wrangler d1 migrations apply anakberani-db --remote",
    "build": "node scripts/build-content.mjs",
    "predeploy": "npm run build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && wrangler deploy --dry-run",
    "types": "wrangler types",
    "release": "node scripts/release.mjs",
    "pretest": "npm run build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20261001.0-alpha",
    "wrangler": "^4.147.0"
  },
  "type": "module"
}
